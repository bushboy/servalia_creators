# Copy this file to .env and adjust for your environment.

POSTGRES_USER=thebe
POSTGRES_PASSWORD=thebe
POSTGRES_DB=thebe

# SQLAlchemy async database URL.
# Native local Postgres often uses 5432. Docker Compose publishes Postgres on 5433:
# postgresql+asyncpg://thebe:thebe@localhost:5433/thebe
DATABASE_URL=postgresql+asyncpg://thebe:thebe@localhost:5432/thebe

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# PII/FERPA/POPIA encryption for audit snapshots.
# Generate a fresh key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# CORS origins for browser clients. Use a strict allow-list in production.
# Include :3080 when using Docker Compose (CreatorTrust frontend host port).
CORS_ORIGINS=http://localhost:5173,http://localhost:3080
CORS_ALLOW_CREDENTIALS=true

# Logging level
LOG_LEVEL=info

# Minds Builder API (server-side only — never VITE_*).
# Required for live Mind chat. Default host is https://api.build.hellominds.ai
# if MINDS_API_BASE_URL is empty. A trailing /v1 is stripped.
# Auth is X-Api-Key. Chat uses a conversation alias (MINDS_CONVERSATION_ALIAS).
MINDS_API_BASE_URL=https://api.build.hellominds.ai
MINDS_API_KEY=
MINDS_MIND_ID=mara
MINDS_MIND_EMAIL=mara@minds.local
MINDS_CONVERSATION_ALIAS=creatortrust

# Local manuscript and package storage
UPLOAD_DIR=data/uploads
PACKAGE_DIR=data/packages
