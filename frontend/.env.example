# API base URL used by the SPA.
# Prefer /api so Vite proxies to the Compose API on host 8100 (see vite.config.ts).
# Direct URL http://localhost:8100 also works; use http://localhost:8000 for host uvicorn.
VITE_API_BASE_URL=/api

# OIDC provider configuration. Keycloak example (Compose host port 8180):
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/servalia
VITE_OIDC_CLIENT_ID=creatortrust-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/login/callback
VITE_OIDC_SCOPE=openid profile email

# Optional: post-logout redirect URI.
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login

# If OIDC variables above are not set, the app falls back to API-key sign-in
# for local development. Use the key-id:secret created by the backend seed.
